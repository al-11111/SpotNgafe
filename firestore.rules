rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi kafe: hanya bisa dibaca oleh pengguna yang login, penulisan ditolak dari aplikasi
    match /cafes/{cafeId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Koleksi laporan kepadatan:
    // Baca untuk pengguna login
    // Buat hanya bila userId sesuai auth uid, status valid (Sepi, Sedang, Penuh), dan waktu server
    // Update dan delete selalu ditolak
    match /reports/{reportId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['Sepi', 'Sedang', 'Penuh']
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
